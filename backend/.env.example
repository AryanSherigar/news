# ============================================================================
# Story Arc Tracker - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# Uncomment options as needed for your deployment
# 
# See README.md for complete documentation of all settings
# ============================================================================

# ============================================================================
# AWS Configuration (REQUIRED)
# ============================================================================
AWS_REGION=us-east-1

# ============================================================================
# Bedrock LLM Models (REQUIRED)
# ============================================================================
# Default model for complex narrative analysis
BEDROCK_LLM_DEFAULT_MODEL_ID=amazon.nova-pro-v1:0

# Lightweight model for simple queries
BEDROCK_LLM_SIMPLE_MODEL_ID=amazon.nova-2-lite-v1:0

# Model for chat responses
BEDROCK_LLM_CHAT_MODEL_ID=amazon.nova-2-lite-v1:0

# Model for voice responses (optimized for latency)
BEDROCK_LLM_VOICE_MODEL_ID=amazon.nova-2-sonic-v1:0

# Fallback model if primary models fail
BEDROCK_LLM_FALLBACK_MODEL_ID=mistral.mistral-large-3-675b-instruct

# Model temperature (0.0 = deterministic, 1.0 = creative; default 0.2)
BEDROCK_LLM_TEMPERATURE=0.2

# Character threshold for switching to simple model (default 6000)
BEDROCK_LLM_SIMPLE_CONTEXT_CHAR_THRESHOLD=6000

# Enable fallback model chain on failure (default true)
BEDROCK_LLM_ENABLE_FALLBACK=true

# ============================================================================
# Bedrock Embeddings (REQUIRED)
# ============================================================================
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
BEDROCK_EMBEDDING_NORMALIZE=true

# ============================================================================
# Vector Database: Pinecone (Choose: Pinecone OR OpenSearch)
# ============================================================================
# Pinecone (managed SaaS option - recommended for quick start)
PINECONE_API_KEY=your_pinecone_api_key_here
# Index host ONLY (no https:// prefix)
# Example: my-index-abc123.svc.us-east-1-aws.pinecone.io
PINECONE_INDEX_HOST=your-index-host.svc.region.pinecone.io
PINECONE_TOP_K=12
PINECONE_NAMESPACE=all_timelines
PINECONE_USE_TIMELINE_NAMESPACE=false
PINECONE_TIMEOUT_SECONDS=15
PINECONE_MAX_RETRIES=3

# ============================================================================
# Vector Database: OpenSearch (Alternative to Pinecone)
# ============================================================================
# Uncomment to use OpenSearch instead of Pinecone
# OPENSEARCH_HOST=https://your-opensearch-domain.us-east-1.es.amazonaws.com
# OPENSEARCH_INDEX_NAME=timeline_chunks
# OPENSEARCH_TOP_K=12
# OPENSEARCH_TIMEOUT_SECONDS=15
# OPENSEARCH_MAX_RETRIES=3

# ============================================================================
# Voice Settings
# ============================================================================
# Enable duplex voice (simultaneous input/output)
VOICE_DUPLEX_ENABLED=true

# Audio sample rate (Hz)
VOICE_SAMPLE_RATE_HZ=16000

# TTS output chunk size (bytes)
VOICE_OUTPUT_CHUNK_BYTES=3200

# Amazon Polly voice options: Joanna, Matthew, Aria, etc.
VOICE_TTS_VOICE_ID=Joanna

# Silence timeout for speech end detection (ms)
VOICE_STT_SILENCE_TIMEOUT_MS=900

# Max total silence before forcing utterance end (ms)
VOICE_STT_MAX_SILENCE_MS=12000

# Timeout for partial transcription updates (ms)
VOICE_STT_PARTIAL_TIMEOUT_MS=2500

# WebSocket reconnect backoff delay (ms)
VOICE_STT_RECONNECT_BACKOFF_MS=350

# ============================================================================
# Source Policy & Citation Validation
# ============================================================================
# Enable strict allowlist validation (reject sources not in allowlist)
SOURCE_POLICY_STRICT_ALLOWLIST_VALIDATION=false

# JSON array of allowed domains
# Example: ["bbc.com", "reuters.com", "apnews.com"]
SOURCE_POLICY_ALLOWED_DOMAINS=[]

# JSON array of allowed news source IDs
SOURCE_POLICY_ALLOWED_SOURCE_IDS=[]

# JSON object mapping domain -> source code aliases
SOURCE_POLICY_SOURCE_ALIASES={}

# Error message when policy violations detected
SOURCE_POLICY_FALLBACK_TEXT=I don't have enough source-backed information

# Refresh response with fresh news if confidence below this threshold
SOURCE_POLICY_REFRESH_CONFIDENCE_THRESHOLD=0.45

# Minimum timeline events required for refresh
SOURCE_POLICY_REFRESH_MIN_TIMELINE_EVENTS=2

# Minimum citations required for refresh
SOURCE_POLICY_REFRESH_MIN_CITATIONS=2

# Maximum fresh results to append during refresh
SOURCE_POLICY_REFRESH_MAX_RESULTS=6

# ============================================================================
# Chat Configuration
# ============================================================================
# Simulated network delay for testing (milliseconds, default 0)
CHAT_STREAM_SIMULATED_DELAY_MS=0

# ============================================================================
# Optional: Google Gemini (Fallback only - legacy support)
# ============================================================================
# Uncomment to enable Gemini as fallback
# GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Production Configuration Example
# ============================================================================
# Use this as reference for production deployments with strict validation:
#
# AWS_REGION=us-east-1
# BEDROCK_LLM_TEMPERATURE=0.1
# BEDROCK_LLM_ENABLE_FALLBACK=true
# SOURCE_POLICY_STRICT_ALLOWLIST_VALIDATION=true
# SOURCE_POLICY_ALLOWED_DOMAINS=["bbc.com","reuters.com","apnews.com"]
# SOURCE_POLICY_REFRESH_CONFIDENCE_THRESHOLD=0.5
# VOICE_DUPLEX_ENABLED=true
